AGENTOS_ENV=local
AGENTOS_SQLITE_PATH=backend/agentos_lite.db
AGENTOS_DEFAULT_USER_ID=local-user
LLM_PROVIDER=mock
LLM_FALLBACK_TO_MOCK=true

# Gemini provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview

# OpenAI-compatible provider examples:
# DeepSeek: LLM_BASE_URL=https://api.deepseek.com, LLM_MODEL=deepseek-chat
# Qwen DashScope International: LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1, LLM_MODEL=qwen-plus
# Ollama local: LLM_BASE_URL=http://localhost:11434/v1, LLM_API_KEY=ollama, LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

EMBEDDING_PROVIDER=mock
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=mock-hash-16
RAG_MODE=local_keyword_mock_embedding
STRICT_CITATION_MODE=true
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
