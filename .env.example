APP_ENV=local
AGENTOS_SQLITE_PATH=backend/agentos_lite.db
AGENTOS_DEFAULT_USER_ID=local-user
LLM_PROVIDER=mock
LLM_FALLBACK_TO_MOCK=true
DEMO_MODE=false
MAX_LLM_CALLS_PER_USER_PER_DAY=5
DEMO_FALLBACK_TO_MOCK=true

# Gemini provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview

EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=mock-hash-16
RAG_MODE=local_keyword_mock_embedding
STRICT_CITATION_MODE=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Frontend uses frontend/.env.example. Kept here as a convenient root reference.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8010
