AGENTOS_ENV=local
AGENTOS_SQLITE_PATH=backend/agentos_lite.db
AGENTOS_DEFAULT_USER_ID=local-user
LLM_PROVIDER=mock
LLM_FALLBACK_TO_MOCK=true
DEMO_MODE=false
MAX_LLM_CALLS_PER_SESSION=20
MAX_LLM_CALLS_PER_DAY=100

# Gemini provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview

EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=mock-hash-16
RAG_MODE=local_keyword_mock_embedding
STRICT_CITATION_MODE=true
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
